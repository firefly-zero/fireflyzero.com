{% extends "base.html.j2" %}
{% block body %}

  <aside class="row mt-2 justify-content-center">
    {% for link in menu %}
      <div class="col col-12 col-sm-6 col-md-4 col-lg-2 mb-1">
        <a href="{{ link.link }}" target="_blank" class="btn btn-primary" style="min-width: 100%">
          <i class="{{ link.icon }}"></i>
          {{ link.name }}
        </a>
      </div>
    {% endfor %}
  </aside>

  <header class="row section mt-4" style="background-color: #38b764;">
    <div class="alert col-6">
      <p class="lead" style="margin-bottom: 0px">
        This is
      </p>
      <h1>Firefly Zero</h1>
      <p class="lead">
        A modern handheld game console with effortless multiplayer.
      </p>
    </div>
  </header>

  <section class="row justify-content-end section" style="background-color: #3b5dc9;">
    <div class="alert col-6">
      <h2>Same-room multiplayer</h1>
      <ol class="lead">
        <li>Get up to 8 devices</li>
        <li>Press a button</li>
        <li>Play together with friends!</li>
      </ol>
    </div>
  </section>

{% endblock %}

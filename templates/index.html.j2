{% extends "base.html.j2" %}
{% block body %}

  <aside class="row mt-3 mb-3 justify-content-center">
    {% for link in menu %}
      <div class="col col-12 col-sm-6 col-md-4 col-lg-2 mb-1">
        <a href="{{ link.link }}" target="_blank" class="btn btn-primary" style="min-width: 100%; transform: rotate(2deg)">
          <i class="{{ link.icon }}"></i>
          {{ link.name }}
        </a>
      </div>
    {% endfor %}
  </aside>

  <header class="row section section1">
    <div class="col-12 col-md-6">
      <div class="alert mt-5" style="transform: rotate(-4deg)">
        <p class="lead" style="margin-bottom: 0px">
          This is
        </p>
        <h1 style="color: #b13e53;">Firefly Zero<span class="text-muted">*</span></h1>
        <p class="lead">
          A modern handheld game console with effortless multiplayer.
        </p>
        <p class="text-muted">
          *All the photos are of the first prototype.
          The final device will be even cooler!
        </p>
        <p class="lead">
          <a href="#kickstarter" class="btn btn-primary">
            buy?
          </a>
        </p>
      </div>
    </div>
  </header>

  <section class="row justify-content-end section section2">
    <div class="col-12 col-md-6">
      <div class="alert mt-5" style="transform: rotate(4deg)">
        <h2>Same-room multiplayer</h1>
        <ul class="lead">
          <li>Connect up to 8 devices!</li>
          <li>Wireless</li>
          <li>No internet connection needed</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="row section section3">
    <div class="col-12 col-md-6">
      <div class="alert mt-5" style="transform: rotate(-4deg)">
        <h2>Touchpad</h1>
        <p class="lead">
          It's very precise and feels good.
        </p>
      </div>
    </div>
  </section>

  <section class="row justify-content-end section section4">
    <div class="col-12 col-md-6">
      <div class="alert mt-5" style="transform: rotate(4deg)">
        <h2>Unique games</h1>
        <p class="lead">
          It's not another retro emulator.
          It's a brand new game console with lots of games
          created with multiplayer and touchpad in mind.
        </p>
        <p class="lead">
          <a href="https://catalog.fireflyzero.com/" class="btn btn-primary" target="_blank">
            game catalog
          </a>
        </p>
      </div>
    </div>
  </section>

  <section class="row section section5">
    <div class="col-12 col-md-6">
      <div class="alert mt-5" style="transform: rotate(-4deg)">
        <h2>You own it</h1>
        <ul class="lead">
          <li>No DRM</li>
          <li>No subscription</li>
          <li>No online connection</li>
          <li>Repair guides</li>
          <li>Everything is open source</li>
        </ul>
        <p class="lead">
          <a href="https://github.com/firefly-zero" class="btn btn-primary" target="_blank">
            <i class="fa-brands fa-github"></i>
            source code
          </a>
          <a href="https://docs.fireflyzero.com/user/repair/" class="btn btn-primary" target="_blank">
            <i class="fa-solid fa-wrench"></i>
            repair guide
          </a>
        </p>
      </div>
    </div>
  </section>

  <section class="row justify-content-end section section6">
    <div class="col-12 col-md-6">
      <div class="alert mt-5" style="transform: rotate(4deg)">
        <h2>Make your own games</h1>
        <ul class="lead">
          <li>Official SDKs for 8 programming languages</li>
          <li>Guides on making your first game without prior experience</li>
          <li>Detailed docs and amazing online community</li>
          <li>Desktop emulator and fantastic developer tools</li>
        </ul>
        <p class="lead">
          <a href="https://docs.fireflyzero.com/dev/" class="btn btn-primary" target="_blank">
            developer guide
          </a>
        </p>
      </div>
    </div>
  </section>

  <section id="kickstarter" class="row justify-content-center section" style="background-color: #a7f070">
    <div class="col-12 col-md-6">
      <div class="alert mt-5" style="transform: rotate(-4deg)">
        <h2>Sounds fun?</h1>
        <p class="lead" style="color: #b13e53">
          <b>You'll be able to get Firefly Zero in 2027.</b>
        </p>
        <p class="lead">
          Leave your email and we'll text you when Kickstarter is live.
        </p>
        <form
          class="col-md-6 mb-3 justify-content-center"
          action="https://submit-form.com/lK1cnaFkB"
          data-botpoison-public-key="pk_032fb23e-a184-404d-ada0-4122b8ae5a70"
        >
            <div class="input-group">
              <input type="email" name="email" placeholder="email" required class="form-control" />
              <button type="submit" class="btn btn-primary">send</button>
        </form>
      </div>
    </div>
  </section>

  <section class="row justify-content-around section section8">
    <div class="col-12 col-md-4">
      <div class="alert mt-5" style="transform: rotate(-4deg)">
        <h2 class="text-center">Team</h2>
        <p class="text-center lead">
          Two geeks making a fun project.
        </p>
      </div>
    </div>
    <div class="w-100"></div>
    <div class="col-6 col-md-3">
      <div class="alert mt-5" style="transform: rotate(-4deg)">
        <h2 class="text-center">Gram</h2>
        <p class="text-center">
          <i class="fa-solid fa-code"></i>
          Software
        </p>
        <p class="text-center">
          <a href="https://github.com/orsinium" target="_blank" type="button" class="btn btn-primary">
            <i class="fa-brands fa-github"></i>
            github
          </a>
          <a href="https://fosstodon.org/@orsinium" target="_blank" type="button" class="btn btn-primary">
            <i class="fa-brands fa-mastodon"></i>
            mastodon
          </a>
        </p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="alert mt-5" style="transform: rotate(4deg)">
        <h2 class="text-center">Alex</h2>
        <p class="text-center">
          <i class="fa-solid fa-microchip"></i>
          Hardware
        </p>
      </div>
    </div>
  </section>

  <section class="row justify-content-around section" style="background-color: #3b5dc9;">
    <div class="col-12 col-md-4">
      <div class="alert mt-5" style="transform: rotate(-4deg)">
        <h2 class="text-center">Follow us</h2>
      </div>
    </div>
    <div class="row col-12 mb-4" style="transform: rotate(-4deg)">
    {% for link in social %}
      <div class="col col-12 col-sm-6 col-md-4 col-lg-3 mb-1" style="transform: rotate(8deg)">
        <a href="{{ link.link }}" target="_blank" rel="me" class="btn btn-primary" style="min-width: 100%">
          <i class="{{ link.icon }}"></i>
          {{ link.name }}
        </a>
      </div>
    {% endfor %}
      </div>
  </section>

  <section class="row justify-content-center">
    <div class="col-md-6">
      <img src="manga-white.webp" style="max-width: 100%" />
    </div>
  </section>

{% endblock %}
